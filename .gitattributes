# Normalize all text files to LF in the repository.
* text=auto eol=lf

# Binary assets must never be converted or diffed as text.
*.png binary
*.jpg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary

# Keep the built bundle out of diffs; it is regenerated by `node build.mjs`.
client.js -diff linguist-generated=true
